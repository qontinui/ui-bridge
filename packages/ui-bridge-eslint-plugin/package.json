{
  "name": "@qontinui/ui-bridge-eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint plugin for the UI Bridge IR — flags conditional rendering at configuration boundaries that the IR builder cannot statically pick up.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "ui-bridge",
    "eslint",
    "eslint-plugin",
    "lint",
    "ir",
    "state-machine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qontinui/ui-bridge.git",
    "directory": "packages/ui-bridge-eslint-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.59.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "8.59.2",
    "@typescript-eslint/rule-tester": "8.59.2",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
