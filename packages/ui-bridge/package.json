    "./ctr/migrate": {
      "types": "./dist/ctr/migrate.d.ts",
      "import": "./dist/ctr/migrate.mjs",
      "require": "./dist/ctr/migrate.js"
    },
    "./verification-layers": {
      "types": "./dist/verification-layers/index.d.ts",
      "import": "./dist/verification-layers/index.mjs",
      "require": "./dist/verification-layers/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.mjs",
      "require": "./dist/artifacts/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node -e \"process.exit(require('fs').statSync('dist/index.d.ts').size > 0 ? 0 : 1)\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "node ../../scripts/check-clean-tree.cjs && npm run build"
  },
  "peerDependencies": {
    "@qontinui/ui-bridge-auto": ">=0.1.0",
    "@qontinui/ui-bridge-headless": ">=0.1.0",
    "express": "^4.18.0 || ^5.0.0",
    "next": ">=13.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.70.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "ws": {
