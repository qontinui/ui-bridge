    },
    "@qontinui/ui-bridge-headless": {
      "optional": true
    }
  },
  "dependencies": {
    "dom-accessibility-api": "^0.5.16"
  },
  "optionalDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@qontinui/ui-bridge-auto": "file:../../../ui-bridge-auto",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "jsdom": "^23.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/qontinui/ui-bridge.git",
    "directory": "packages/ui-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "automation",
    "testing",
    "ai",
    "debugging",
    "hooks",
    "server",
    "react-native"
  ]
}
