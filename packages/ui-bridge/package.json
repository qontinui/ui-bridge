      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./control": {
      "types": "./dist/control/index.d.ts",
      "import": "./dist/control/index.mjs",
      "require": "./dist/control/index.js"
    },
    "./render-log": {
      "types": "./dist/render-log/index.d.ts",
      "import": "./dist/render-log/index.mjs",
      "require": "./dist/render-log/index.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug/index.mjs",
      "require": "./dist/debug/index.js"
    },
    "./vision": {
      "types": "./dist/vision/index.d.ts",
      "import": "./dist/vision/index.mjs",
      "require": "./dist/vision/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.mjs",
      "require": "./dist/ai/index.js"
    },
    "./idle": {
      "types": "./dist/idle/index.d.ts",
      "import": "./dist/idle/index.mjs",
      "require": "./dist/idle/index.js"
    },
    "./annotations": {
      "types": "./dist/annotations/index.d.ts",
      "import": "./dist/annotations/index.mjs",
      "require": "./dist/annotations/index.js"
    },
