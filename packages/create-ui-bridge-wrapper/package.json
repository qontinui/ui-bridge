{
  "name": "create-ui-bridge-wrapper",
  "version": "0.1.0",
  "description": "Scaffold a new UI Bridge wrapper app (api / headless / headed / live).",
  "type": "module",
  "bin": {
    "create-ui-bridge-wrapper": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "dist/templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "keywords": [
    "ui-bridge",
    "wrapper",
    "scaffold",
    "cli",
    "create",
    "template"
  ],
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/qontinui/ui-bridge.git",
    "directory": "packages/create-ui-bridge-wrapper"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/semver": "^7.7.1",
    "rimraf": "^5.0.0",
    "semver": "^7.7.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
