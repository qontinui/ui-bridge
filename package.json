{
  "name": "ui-bridge-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UI Bridge Framework - Unified UI observation, control, and debugging for AI automation",
  "workspaces": [
    "packages/*",
    "examples/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test -w e2e",
    "lint": "eslint packages/ui-bridge/src packages/ui-bridge-extension/src packages/ui-bridge-native/src packages/ui-bridge-server/src",
    "lint:fix": "eslint packages/ui-bridge/src packages/ui-bridge-extension/src packages/ui-bridge-native/src packages/ui-bridge-server/src --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "node -e \"try { require('husky').install() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qontinui/ui-bridge.git"
  },
  "keywords": [
    "ui",
    "automation",
    "testing",
    "react",
    "ai",
    "debugging"
  ]
}
